{
  "name": "hu-gioi",
  "version": "0.2.0",
  "private": true,
  "description": "Hư Giới — game idle tu tiên: client, dữ liệu thiết kế, engine luật dùng chung và máy chủ",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --mode readable",
    "build:min": "vite build && node tools/check-css-bundle.cjs",
    "check": "node tools/check-data.mjs --strict && node --test tests/sources.test.cjs && npm run typecheck",
    "test": "node --test tests/*.test.cjs",
    "balance": "node tools/simulate-balance.mjs",
    "build:edge": "node tools/build-edge.cjs",
    "edge:budget": "node tools/simulate-edge-calls.cjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
